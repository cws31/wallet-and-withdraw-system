                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Admin Credit Wallet",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currency\": \"VES\",\n  \"amount\": 100,\n  \"transactionType\": \"ADMIN_CREDIT\",\n  \"source\": \"POSTMAN\",\n  \"referenceId\": \"POSTMAN-CREDIT-001\",\n  \"description\": \"Postman admin credit test\",\n  \"metadata\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/wallet/credit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "wallet",
                "credit"
              ]
            }
          }
        },
        {
          "name": "Admin Debit Wallet",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currency\": \"VES\",\n  \"amount\": 100,\n  \"transactionType\": \"ADMIN_DEBIT\",\n  \"source\": \"POSTMAN\",\n  \"referenceId\": \"POSTMAN-DEBIT-001\",\n  \"description\": \"Postman admin debit test\",\n  \"metadata\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/wallet/debit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "wallet",
