            ],
            "url": {
              "raw": "{{baseUrl}}/api/withdrawals?page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "withdrawals"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Get Withdrawal Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/withdrawals/{{withdrawalId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "withdrawals",
                "{{withdrawalId}}"
              ]
            }
          }
        },
        {
          "name": "Cancel Withdrawal",
          "request": {
            "method": "PATCH",
