              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/withdrawals/{{withdrawalId}}/reject?rejectionReason=Test rejection&reviewNote=Postman rejection test",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
