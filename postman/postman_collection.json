            "url": {
              "raw": "{{baseUrl}}/api/withdrawals/{{withdrawalId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "withdrawals",
                "{{withdrawalId}}",
                "cancel"
              ]
            }
          }
        },
        {
          "name": "Admin Move to Processing",
          "request": {
            "method": "PATCH",
            "header": [
